--- a/hostap/src/common/sae.h
+++ b/hostap/src/common/sae.h
@@ -62,6 +62,7 @@ struct sae_temporary_data {
 	int vlan_id;
 	u8 bssid[ETH_ALEN];
 	struct wpabuf *own_rejected_groups;
+	int *own_rejected_groups_int;
 	struct wpabuf *peer_rejected_groups;
 	unsigned int own_addr_higher:1;
 
diff --git a/hostap/wpa_supplicant/mesh_rsn.c b/hostap/wpa_supplicant/mesh_rsn.c
index 7a2762a..ae8a524 100644
--- a/hostap/wpa_supplicant/mesh_rsn.c
+++ b/hostap/wpa_supplicant/mesh_rsn.c
@@ -40,11 +40,12 @@ void mesh_auth_timer(void *eloop_ctx, void *user_data)
 		wpa_printf(MSG_DEBUG, "AUTH: Re-authenticate with " MACSTR
 			   " (attempt %d) ",
 			   MAC2STR(sta->addr), sta->sae_auth_retry);
-		wpa_msg(wpa_s, MSG_INFO, MESH_SAE_AUTH_FAILURE "addr=" MACSTR,
-			MAC2STR(sta->addr));
 		if (sta->sae_auth_retry < MESH_AUTH_RETRY) {
 			mesh_rsn_auth_sae_sta(wpa_s, sta);
+			sta->sae_auth_retry++;
 		} else {
+			wpa_msg(wpa_s, MSG_INFO, MESH_SAE_AUTH_FAILURE "addr=" MACSTR,
+				MAC2STR(sta->addr));
 			hapd = wpa_s->ifmsh->bss[0];
 
 			if (sta->sae_auth_retry > MESH_AUTH_RETRY) {
@@ -300,45 +301,69 @@ struct mesh_rsn *mesh_rsn_auth_init(struct wpa_supplicant *wpa_s,
 }
 
 
-static int index_within_array(const int *array, int idx)
-{
-	int i;
-
-	for (i = 0; i < idx; i++) {
-		if (array[i] == -1)
-			return 0;
-	}
-
-	return 1;
-}
-
-
 static int mesh_rsn_sae_group(struct wpa_supplicant *wpa_s,
-			      struct sae_data *sae)
+			      struct sta_info *sta)
 {
 	int *groups = wpa_s->ifmsh->bss[0]->conf->sae_groups;
+	int i, j;
+	struct sae_data *sae = sta->sae;
 
-	/* Configuration may have changed, so validate current index */
-	if (!index_within_array(groups, wpa_s->mesh_rsn->sae_group_index))
+	if (!groups)
 		return -1;
 
-	for (;;) {
-		int group = groups[wpa_s->mesh_rsn->sae_group_index];
-
-		if (group <= 0)
+	/* Find our current group in the enabled list */
+	for (i = 0; groups[i] > 0; i++) {
+		if (sae->group == groups[i])
 			break;
-		if (sae_set_group(sae, group) == 0) {
-			wpa_dbg(wpa_s, MSG_DEBUG, "SME: Selected SAE group %d",
-				sae->group);
+	}
+
+	if (groups[i] > 0) {
+		/* We have a current group, try to pick the next one if it was rejected */
+		bool rejected = false;
+		if (sae->tmp && sae->tmp->own_rejected_groups_int) {
+			for (j = 0; sae->tmp->own_rejected_groups_int[j] > 0; j++) {
+				if (sae->tmp->own_rejected_groups_int[j] == sae->group) {
+					rejected = true;
+					break;
+				}
+			}
+		}
+		if (rejected) {
+			i++;
+		} else {
+			/* Stay on current group if it works */
+			return 0;
+		}
+	} else {
+		/* No group selected yet, start from the first one */
+		i = 0;
+	}
+
+	for (; groups[i] > 0; i++) {
+		bool rejected = false;
+		if (sae->tmp && sae->tmp->own_rejected_groups_int) {
+			for (j = 0; sae->tmp->own_rejected_groups_int[j] > 0; j++) {
+				if (sae->tmp->own_rejected_groups_int[j] == groups[i]) {
+					rejected = true;
+					break;
+				}
+			}
+		}
+		if (rejected)
+			continue;
+
+		if (sae_set_group(sae, groups[i]) == 0) {
+			wpa_dbg(wpa_s, MSG_DEBUG, "SAE: Selected group %d for " MACSTR,
+				sae->group, MAC2STR(sta->addr));
 			return 0;
 		}
-		wpa_s->mesh_rsn->sae_group_index++;
 	}
 
 	return -1;
 }
 
 
+
 static int mesh_rsn_build_sae_commit(struct wpa_supplicant *wpa_s,
 				     struct wpa_ssid *ssid,
 				     struct sta_info *sta)
@@ -353,7 +378,7 @@ static int mesh_rsn_build_sae_commit(struct wpa_supplicant *wpa_s,
 		return -1;
 	}
 
-	if (mesh_rsn_sae_group(wpa_s, sta->sae) < 0) {
+	if (mesh_rsn_sae_group(wpa_s, sta) < 0) {
 		wpa_msg(wpa_s, MSG_DEBUG, "SAE: Failed to select group");
 		return -1;
 	}
@@ -366,7 +391,9 @@ static int mesh_rsn_build_sae_commit(struct wpa_supplicant *wpa_s,
 
 	if (ssid->pt &&
 	    sae_prepare_commit_pt(sta->sae, ssid->pt, wpa_s->own_addr,
-				  sta->addr, NULL, NULL) == 0)
+				  sta->addr,
+				  sta->sae->tmp->own_rejected_groups_int,
+				  NULL) == 0)
 		return 0;
 
 	return sae_prepare_commit(wpa_s->own_addr, sta->addr,
@@ -395,6 +422,7 @@ int mesh_rsn_auth_sae_sta(struct wpa_supplicant *wpa_s,
 		sta->sae = os_zalloc(sizeof(*sta->sae));
 		if (sta->sae == NULL)
 			return -1;
+		sae_set_group(sta->sae, wpa_s->ifmsh->bss[0]->conf->sae_groups[0]);
 	}
 
 	pmksa = wpa_auth_pmksa_get(hapd->wpa_auth, sta->addr, NULL);
