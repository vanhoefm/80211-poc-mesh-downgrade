From 0775534d7b3a65df86005bdd3fcedfb26ea44ca0 Mon Sep 17 00:00:00 2001
From: Mathy Vanhoef <Mathy.Vanhoef@kuleuven.be>
Date: Mon, 20 Apr 2026 03:18:28 +0200
Subject: [PATCH] hostap: defense using prefix in scalar

This commit should be applied on top of commit "hostap: working
simulated attack".

This was tested to prevent the simulated attack, against both STAs
supporting both group 21 and 19. It was also tested without a simulated
adversary being present, where one STA supported 21 and 19, and the
other STA supported group 20 and 19.
---
 hostap/src/common/sae.c |  115 +++-
 mesh1.log               | 1305 ---------------------------------------
 mesh2.log               | 1297 --------------------------------------
 3 files changed, 108 insertions(+), 2609 deletions(-)
 delete mode 100644 mesh1.log
 delete mode 100644 mesh2.log

diff --git a/hostap/src/common/sae.c b/hostap/src/common/sae.c
index f3f096f..9f8ba96 100644
--- a/hostap/src/common/sae.c
+++ b/hostap/src/common/sae.c
@@ -1341,14 +1341,85 @@ static int sae_derive_commit(struct sae_data *sae)
 		sae->tmp->sae_rand = crypto_bignum_init();
 	if (!sae->tmp->own_commit_scalar)
 		sae->tmp->own_commit_scalar = crypto_bignum_init();
-	ret = !mask || !sae->tmp->sae_rand || !sae->tmp->own_commit_scalar ||
-		dragonfly_generate_scalar(sae->tmp->order, sae->tmp->sae_rand,
+	if (!mask || !sae->tmp->sae_rand || !sae->tmp->own_commit_scalar) {
+		crypto_bignum_deinit(mask, 1);
+		return -1;
+	}
+
+	if (sae->tmp->own_rejected_groups_int && sae->tmp->own_rejected_groups_int[0] > 0) {
+		int count = 0;
+		int count_val;
+		u8 *buf;
+		
+		while (sae->tmp->own_rejected_groups_int[count] > 0)
+			count++;
+		
+		count_val = count;
+		buf = os_malloc(sae->tmp->order_len);
+		if (!buf) {
+			crypto_bignum_deinit(mask, 1);
+			return -1;
+		}
+
+		/* Loop until we find a valid scalar and mask */
+		for (count = 0; count < 100; count++) {
+			os_get_random(buf, sae->tmp->order_len);
+			buf[0] = 0x40;
+			buf[1] = 0xD8;
+			buf[2] = 0x55;
+			buf[3] = 0x00;
+			buf[4] = 0x00;
+			buf[5] = 0x00;
+			buf[6] = (u8)count_val;
+			
+			/* Ensure scalar is valid */
+			crypto_bignum_deinit(sae->tmp->own_commit_scalar, 0);
+			sae->tmp->own_commit_scalar = crypto_bignum_init_set(buf, sae->tmp->order_len);
+			
+			if (!sae->tmp->own_commit_scalar ||
+			    crypto_bignum_cmp(sae->tmp->own_commit_scalar, sae->tmp->order) >= 0 ||
+			    crypto_bignum_is_zero(sae->tmp->own_commit_scalar) ||
+			    crypto_bignum_is_one(sae->tmp->own_commit_scalar))
+				continue;
+
+			/* Pick a valid rand */
+			if (crypto_bignum_rand(sae->tmp->sae_rand, sae->tmp->order) != 0 ||
+			    crypto_bignum_is_zero(sae->tmp->sae_rand) ||
+			    crypto_bignum_is_one(sae->tmp->sae_rand))
+				continue;
+			
+			/* Calculate mask: mask = (scalar + order - rand) mod order */
+			if (crypto_bignum_add(sae->tmp->own_commit_scalar, sae->tmp->order, mask) != 0 ||
+			    crypto_bignum_sub(mask, sae->tmp->sae_rand, mask) != 0 ||
+			    crypto_bignum_mod(mask, sae->tmp->order, mask) != 0)
+				continue;
+				
+			/* Ensure mask is valid */
+			if (!crypto_bignum_is_zero(mask) && !crypto_bignum_is_one(mask))
+				break; /* Found a valid set! */
+		}
+		
+		os_free(buf);
+		
+		if (count == 100) {
+			wpa_printf(MSG_DEBUG, "SAE: Failed to generate encoded scalar");
+			ret = -1;
+		} else {
+			ret = 0;
+		}
+	} else {
+		ret = dragonfly_generate_scalar(sae->tmp->order, sae->tmp->sae_rand,
 					  mask,
-					  sae->tmp->own_commit_scalar) < 0 ||
-		(sae->tmp->ec &&
-		 sae_derive_commit_element_ecc(sae, mask) < 0) ||
-		(sae->tmp->dh &&
-		 sae_derive_commit_element_ffc(sae, mask) < 0);
+					  sae->tmp->own_commit_scalar);
+	}
+
+	if (ret == 0) {
+		ret = (sae->tmp->ec &&
+		       sae_derive_commit_element_ecc(sae, mask) < 0) ||
+		      (sae->tmp->dh &&
+		       sae_derive_commit_element_ffc(sae, mask) < 0);
+	}
+	
 	crypto_bignum_deinit(mask, 1);
 	return ret ? -1 : 0;
 }
@@ -2231,6 +2302,36 @@ u16 sae_parse_commit(struct sae_data *sae, const u8 *data, size_t len,
 		sae->tmp->peer_rejected_groups = NULL;
 	}
 
+	/* Validate Encoded Scalar Prefix Defense */
+	if (sae->peer_commit_scalar) {
+		u8 *scalar_bytes = os_malloc(sae->tmp->order_len);
+		int bin_res = -1;
+		if (scalar_bytes)
+			bin_res = crypto_bignum_to_bin(sae->peer_commit_scalar, scalar_bytes, sae->tmp->order_len, sae->tmp->order_len);
+		
+		wpa_printf(MSG_DEBUG, "SAE: Validating scalar, bin_res=%d, order_len=%d", bin_res, sae->tmp->order_len);
+		
+		if (scalar_bytes && bin_res == sae->tmp->order_len) {
+			if (sae->tmp->order_len >= 7 &&
+			    scalar_bytes[0] == 0x40 && scalar_bytes[1] == 0xD8 &&
+			    scalar_bytes[2] == 0x55 && scalar_bytes[3] == 0x00 &&
+			    scalar_bytes[4] == 0x00 && scalar_bytes[5] == 0x00) {
+				int claimed_count = scalar_bytes[6];
+				int actual_count = 0;
+				if (sae->tmp->peer_rejected_groups)
+					actual_count = wpabuf_len(sae->tmp->peer_rejected_groups) / 2;
+				
+				wpa_printf(MSG_DEBUG, "SAE: Received encoded scalar with count %d (actual: %d)", claimed_count, actual_count);
+				if (claimed_count != actual_count) {
+					wpa_printf(MSG_INFO, "SAE: Stripping attack detected via scalar prefix! (claimed %d, got %d)", claimed_count, actual_count);
+					os_free(scalar_bytes);
+					return WLAN_STATUS_UNSPECIFIED_FAILURE;
+				}
+			}
+		}
+		os_free(scalar_bytes);
+	}
+
 	/* Optional Anti-Clogging Token Container element */
 	if (h2e)
 		sae_parse_token_container(sae, pos, end, token, token_len);
